# =============================================================================
# Flutter / Dart
# =============================================================================

# Dart tool cache (generated by pub get / flutter pub get)
.dart_tool/

# Pub package cache
.pub-cache/
.pub/

# Flutter plugin dependency cache files
.flutter-plugins
.flutter-plugins-dependencies

# Build output
build/
**/build/

# Coverage reports
coverage/
**/coverage/

# Generated API docs
**/doc/api/

# iOS last build id (auto-generated)
**/ios/Flutter/.last_build_id

# Symbolication and obfuscation maps
app.*.symbols
app.*.map.json

# Widget Preview (Flutter 3.x+)
.widget_preview/

# =============================================================================
# Android
# =============================================================================

# Gradle build outputs & caches
**/android/.gradle/
**/android/gradle/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties

# Android Studio build artifacts
**/android/app/debug/
**/android/app/profile/
**/android/app/release/

# Key store / signing (NEVER commit these)
*.jks
*.keystore
key.properties

# =============================================================================
# iOS / macOS
# =============================================================================

# CocoaPods
**/ios/Pods/
**/macos/Pods/
**/ios/.symlinks/
**/macos/.symlinks/

# Xcode derived data & build artifacts
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/macos/Flutter/Flutter-Debug.xcconfig
**/macos/Flutter/Flutter-Release.xcconfig
xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# Swift Package Manager
.swiftpm/

# =============================================================================
# IDEs & Editors
# =============================================================================

# IntelliJ / Android Studio
.idea/
*.iml
*.ipr
*.iws

# VS Code
# (launch.json / tasks.json are usually repo-specific — uncomment to ignore)
# .vscode/
.vscode/settings.json
.vscode/*.code-workspace

# Vim / Neovim swap files
*.swp
*.swo
*~

# Emacs
\#*\#
.#*

# =============================================================================
# Operating Systems
# =============================================================================

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# =============================================================================
# Logs & Temp Files
# =============================================================================

*.log
*.class
*.pyc
*.pyo
*.tmp
*.temp
*.bak
*.orig

# =============================================================================
# Environment & Secrets
# =============================================================================

# Environment files — may contain API keys, secrets, etc.
.env
.env.*
!.env.example

# Firebase
google-services.json
GoogleService-Info.plist
firebase_options.dart

# =============================================================================
# Miscellaneous
# =============================================================================

# SVN & version control artefacts
.svn/
.history/
.buildlog/
migrate_working_dir/

# Node (if using any Flutter web tooling)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
